# Copy to .env and replace with a generated password, e.g. openssl rand -hex 32.
# Use hexadecimal characters so the password is also safe in DATABASE_URL.
POSTGRES_PASSWORD=
PORT=8070
BIND_ADDRESS=127.0.0.1
# Set the public HTTPS origin behind your reverse proxy.
VB_PUBLIC_ORIGIN=
# Optional email recovery. Use a sender on a domain verified in Resend.
RESEND_API_KEY=
VB_EMAIL_FROM=
# For running Node outside Compose, use a reachable PostgreSQL endpoint:
# DATABASE_URL=postgresql://voxel:YOUR_HEX_PASSWORD@127.0.0.1:5432/voxel
